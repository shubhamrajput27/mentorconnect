# PostgreSQL connection string. Locally, after creating a user and database:
#   psql -U postgres -c "CREATE ROLE mentorconnect LOGIN CREATEDB PASSWORD 'change-me';"
#   psql -U postgres -c "CREATE DATABASE mentorconnect OWNER mentorconnect;"
# In production, use the URL from Neon, Supabase or another hosted Postgres.
DATABASE_URL="postgresql://mentorconnect:change-me@localhost:5432/mentorconnect?schema=public"

# Separate database for the end-to-end tests; it is wiped on every run.
#   psql -U postgres -c "CREATE DATABASE mentorconnect_e2e OWNER mentorconnect;"
E2E_DATABASE_URL="postgresql://mentorconnect:change-me@localhost:5432/mentorconnect_e2e?schema=public"

# Public URL of the site, used in email links and metadata.
APP_URL="http://localhost:3000"

# Email (verification and password reset). Leave RESEND_API_KEY empty in
# development: emails are then saved to .dev-emails/ and the link is printed
# in the terminal. Get a key at https://resend.com.
RESEND_API_KEY=""
EMAIL_FROM="MentorConnect <onboarding@resend.dev>"
